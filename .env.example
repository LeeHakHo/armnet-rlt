# Armnet API key used by rlt-submit-actor, rlt-submit-eval and the image build.
ARMNET_API_KEY=<your-armnet-api-key>

# Hugging Face token: downloads the AutoRLBench models and becomes an Armnet secret.
HF_TOKEN=<your-huggingface-token>

# Names of the Armnet secrets the cell jobs read (scripts/setup.sh creates them).
# RLT_HF_SECRET=huggingface-token-<user>
# RLT_AUTH_SECRET=armnet-rlt-auth-<user>

# Actor image; scripts/setup.sh writes it.
# IMAGE_REF=

# Cell for scripts/run.sh and scripts/eval.sh, and the GPU index on this machine.
# CELL=cell-01
# GPU=0

# BACKEND=modal runs the learner and the policy server on Modal (README, Running on Modal).
# BACKEND=modal
# RLT_MODAL_GPU=L40S

# The cell's one address: ngrok (default) or Tailscale Funnel, or your own TLS ingress
# (see scripts/lib.sh).
# TUNNEL=tailscale
# TAILSCALE="tailscale --socket=/path/to/tailscaled.sock"
# PUBLIC_HOST=
# TLS_CERT=
# TLS_KEY=
# PUBLIC_PORT=443
# FRONT_PORT=50050

# Local learner data root (default: ./experiment-data).
# RLT_DATA_ROOT=/data/armnet-rlt

# Hugging Face datasets <RECORD_REPO>_<name> for the recorded training and evaluation
# episodes (scripts/setup.sh sets <your user>/armnet); public unless RECORD_PUBLIC=0,
# RECORD=0 turns recording off.
# RECORD_REPO=<user>/armnet
