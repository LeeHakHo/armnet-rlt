# Armnet API key used by rlt-submit-actor, rlt-submit-eval and the image build.
ARMNET_API_KEY=<your-armnet-api-key>

# Hugging Face token, used only to create the named Modal/Armnet secrets.
HF_TOKEN=<your-huggingface-token>

# Names of the Armnet secrets the cell jobs read (see README).
RLT_HF_SECRET=huggingface-token

# Local learner data root (default: ./experiment-data).
# RLT_DATA_ROOT=/data/armnet-rlt

# Camera aim applied per cell when --armnet.camera-aim is not given.
# RLT_CELL_CAMERA_AIM=cell-01=top.tilt=0.5

# Modal resources (only with the Modal learner).
RLT_MODAL_VOLUME=pi0-rlt-data
RLT_MODAL_RENDEZVOUS=armnet-rlt-rendezvous
RLT_MODAL_AUTH_SECRET=armnet-rlt-auth
