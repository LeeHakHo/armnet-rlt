# Developer machine: build/push/submit through Armnet.
ARMNET_API_KEY=<your-armnet-api-key>

# Used only while creating the named Modal and Armnet Hugging Face secrets.
# It is never copied into an image or committed to git.
HF_TOKEN=<your-huggingface-token>

# Optional: override the default named resources.
RLT_MODAL_VOLUME=pi0-rlt-data
RLT_MODAL_RENDEZVOUS=armnet-rlt-rendezvous
RLT_MODAL_AUTH_SECRET=armnet-rlt-auth
